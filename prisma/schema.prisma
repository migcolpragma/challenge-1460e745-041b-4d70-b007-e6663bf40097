generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model LoanRequest {
  id                     String            @id @default(uuid())
  operationNumber        String
  channel                String
  applicantName          String
  applicantDocument      String
  requestedAmount        Decimal           @db.Decimal(15, 2)
  currency               String
  termMonths             Int
  interestRate           Decimal           @db.Decimal(10, 4)
  destinationAccount     String
  status                 LoanRequestStatus @default(PENDING)
  antifraudResult        String?
  riskBureauResult       String?
  creditOriginatorResult String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([operationNumber, channel], name: "operationNumber_channel")
  @@index([status])
  @@index([createdAt])
}

enum LoanRequestStatus {
  PENDING
  PENDING_ANTIFRAUD
  APPROVED
  REJECTED
  TIMEOUT
}
